# --- BeetleBot / JetBot / Acrux are tracked as git submodules (see .gitmodules) ---
# They are NOT ignored: only a commit pointer is tracked here, not their file contents.
# First checkout:  git submodule update --init --recursive
# Refresh:          git submodule update --remote

# --- ROS 2 / colcon build artifacts (if you build a workspace inside this repo) ---
build/
install/
log/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Editor / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- ROS runtime ---
*.bag
rosbag2_*/
