#   git clone https://github.com/VEEROBOT/BeetleBot.git BeetleBot
#   (cd BeetleBot && git pull)
BeetleBot/

# --- JetBot (NVIDIA-AI-IOT) — reference clone for comparison with BeetleBot ---
#   git clone https://github.com/NVIDIA-AI-IOT/jetbot.git jetbot
#   (cd jetbot && git pull)
jetbot/

# --- Acrux (VEEROBOT) — reference clone, another VEEROBOT robot platform ---
#   git clone https://github.com/VEEROBOT/acrux.git acrux
#   (cd acrux && git pull)
acrux/

