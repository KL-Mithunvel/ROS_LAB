# --- bots/ holds the robot sources as git submodules (BeetleBot, jetbot, acrux, wolf, rhino) ---
# They are NOT ignored: only a commit pointer is tracked here, not their file contents.
# First checkout:  git submodule update --init --recursive
# Refresh:          git submodule update --remote  (then commit the moved pointer)

# --- ROS 2 / colcon build artifacts (if you build a workspace inside this repo) ---
build/
install/
log/
# ...but learn/build/ is a study-guide folder, not a colcon artifact:
!learn/build/
!learn/build/**

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Editor / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- ROS runtime ---
*.bag
rosbag2_*/
