# Connection settings for the Acrux robot (no secrets here - auth is by SSH key).
ACRUX_HOST=192.168.0.110
ACRUX_USER=bot            # robot name == login user (see bots/acrux/README.md)
ACRUX_KEY=$HOME/.ssh/acrux_ed25519
ACRUX_WS=ros2_ws          # ROS 2 workspace on the robot (~/ros2_ws)
ACRUX_PKG_DIR=ros2_ws/src/acrux   # where this repo's bots/acrux lives on the robot
